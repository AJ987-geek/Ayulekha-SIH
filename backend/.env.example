LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Create this key in the Groq Console. Never put it in the frontend or commit .env.
LLM_API_KEY=replace-with-your-groq-api-key
LLM_TEMPERATURE=0.2

# =====================================================================
# TRIAL PHONE NUMBERS (Add your two trial phone numbers below)
# =====================================================================
TRIAL_PHONE_1=
TRIAL_PHONE_2=

# Optional SMS Provider Keys (Fast2SMS for Indian numbers / Twilio for International)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SID=
