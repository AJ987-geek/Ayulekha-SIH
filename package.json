{
  "name": "ayulekha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev:patient\" \"npm run dev:doctor\"",
    "dev:patient": "vite --config apps/patient/vite.config.js apps/patient",
    "dev:doctor": "vite --config apps/doctor/vite.config.js apps/doctor",
    "dev:backend": "npm run dev --prefix backend",
    "build:patient": "vite build --config apps/patient/vite.config.js apps/patient",
    "build:doctor": "vite build --config apps/doctor/vite.config.js apps/doctor",
    "test:locales": "node scripts/verify-locales.cjs",
    "lint": "oxlint"
  },
  "dependencies": {
    "@tiny-fish/sdk": "^0.8.0",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  }
}
